{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["iconutil", "cc"],
  "ignoreDependencies": ["@pond/theme", "ffmpeg-static", "drizzle-kit"],
  "workspaces": {
    "apps/desktop": {
      "entry": [
        "electron.vite.config.ts",
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/preload/scrape.cjs.ts",
        "src/renderer/src/capture.tsx",
        "src/renderer/src/routes/**/*.{ts,tsx}",
        "scripts/*.{mjs,cjs,ts}",
        "src/renderer/{assistant,components,command-menu-preview}.tsx",
        "prototypes/*/main.tsx",
        "prototypes/*/*.mjs",
        "src/main/core/media-warm/service.ts",
        "src/main/core/enrichment-sidecar.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.{mjs,cjs,ts}",
        "prototypes/**/*.{ts,tsx,mjs}"
      ],
      "ignoreDependencies": ["@tanstack/ai-react"],
      "vite": {
        "config": ["components.vite.config.ts", "prototypes/*/vite.config.ts"]
      }
    },
    "apps/website": {
      "entry": ["app/**/*.{ts,tsx}", "next.config.{js,ts,mjs}"],
      "project": ["**/*.{ts,tsx}"]
    },
    "apps/extension": {
      "entry": ["entrypoints/**/*.{ts,tsx}", "scripts/*.mjs"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/icons": {
      "entry": ["lib/create-icon.tsx", "scripts/*.mjs"]
    },
    "packages/schema": {
      "entry": ["scripts/*.ts"]
    },
    ".": {
      "entry": ["scripts/*.{mjs,cjs,ts}", "tools/**/*.{ts,mjs}"]
    }
  },
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
