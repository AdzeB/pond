{
  "name": "@pond/repo",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "A local-first archive for everything you save across Twitter/X, Instagram, Pinterest, Are.na, Cosmos, TikTok, YouTube, and any web article.",
  "license": "MIT",
  "author": {
    "name": "Raphael Salaja",
    "url": "https://github.com/raphaelsalaja"
  },
  "homepage": "https://github.com/raphaelsalaja/pond#readme",
  "bugs": {
    "url": "https://github.com/raphaelsalaja/pond/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raphaelsalaja/pond.git"
  },
  "packageManager": "pnpm@11.27.0",
  "scripts": {
    "build": "turbo run build perf:check:repo",
    "dev": "node scripts/run-dev-singleton.mjs -- pnpm exec turbo run dev",
    "dev:desktop": "node scripts/run-dev-singleton.mjs -- pnpm --filter @pond/desktop dev",
    "cli": "pnpm --filter @pond/cli exec tsx src/index.ts",
    "cli:build": "pnpm --filter @pond/cli build",
    "cli:link": "pnpm --filter @pond/cli build && pnpm --filter @pond/cli link --global",
    "generate": "pnpm provenance:generate && turbo run generate",
    "generate:check": "pnpm provenance:generated:check && turbo run generate:check",
    "lint": "turbo run lint:repo",
    "lint:repo": "biome ci . --error-on-warnings",
    "knip": "turbo run knip:repo",
    "knip:repo": "pnpm --filter @pond/desktop exec tsr generate && knip",
    "oxlint": "turbo run oxlint:repo",
    "oxlint:repo": "oxlint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "perf:check": "turbo run perf:check:repo",
    "perf:check:repo": "node scripts/check-performance-budgets.mjs",
    "sbom:generate": "pnpm sbom --sbom-format spdx --prod --out pond.spdx.json",
    "dist": "turbo run dist",
    "dist:mac": "turbo run build --filter @pond/desktop && pnpm --filter @pond/desktop dist:mac",
    "dist:win": "pnpm --filter @pond/desktop dist:win",
    "dist:linux": "pnpm --filter @pond/desktop dist:linux",
    "prepare": "husky",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "check": "node --test scripts/run-dev-singleton.test.mjs && pnpm provenance:generated:check && turbo run lint:repo oxlint:repo provenance:check:repo architecture:check:repo knip:repo generate:check typecheck test",
    "provenance:check": "turbo run provenance:check:repo",
    "provenance:check:repo": "node --test scripts/reference-capture.test.mjs && node scripts/run-provenance.mjs check .provenance",
    "provenance:capture:summary": "node scripts/reference-capture.mjs summary",
    "provenance:capture:status": "node scripts/reference-capture.mjs status",
    "provenance:generate": "node scripts/run-provenance.mjs generate .provenance --output-dir docs/provenance/generated",
    "provenance:generated:check": "node scripts/check-provenance-generated.mjs",
    "architecture:check": "turbo run architecture:check:repo",
    "architecture:check:repo": "node --test scripts/check-architecture.test.mjs && node scripts/check-architecture.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@oxlint/plugins": "1.83.0",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "oxc-parser": "0.150.0",
    "oxlint": "1.83.0",
    "@web-kits/provenance": "https://github.com/raphaelsalaja/provenance/releases/download/v0.3.0/web-kits-provenance-0.3.0.tgz",
    "turbo": "^2.10.13",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  }
}
