{
  "name": "pond",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first archive for everything you save across Twitter/X, Instagram, Pinterest, Are.na, Cosmos, TikTok, YouTube, and any web article.",
  "license": "MIT",
  "author": {
    "name": "Raphael Salaja",
    "url": "https://github.com/raphaelsalaja"
  },
  "homepage": "https://github.com/raphaelsalaja/pond#readme",
  "bugs": {
    "url": "https://github.com/raphaelsalaja/pond/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raphaelsalaja/pond.git"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "generate": "turbo run generate",
    "lint": "biome check . --write --unsafe",
    "lint:check": "biome ci .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "new-source": "node ./scripts/new-source.mjs",
    "dist": "turbo run dist",
    "dist:mac": "pnpm --filter @pond/desktop dist:mac",
    "dist:win": "pnpm --filter @pond/desktop dist:win",
    "dist:linux": "pnpm --filter @pond/desktop dist:linux",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/node": "^25.9.3",
    "husky": "^9.1.7",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.12",
    "pnpm": ">=10.0.0"
  }
}
