{
  "name": "@pond/desktop",
  "productName": "Pond",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pond desktop app: local-first archive with a menu-bar tray, local SQLite index and filesystem library.",
  "license": "MIT",
  "author": {
    "name": "Raphael Salaja",
    "url": "https://github.com/raphaelsalaja"
  },
  "homepage": "https://github.com/raphaelsalaja/pond#readme",
  "bugs": {
    "url": "https://github.com/raphaelsalaja/pond/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raphaelsalaja/pond.git",
    "directory": "apps/desktop"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "postinstall": "node ./scripts/rebuild-native.mjs || true && node ./scripts/patch-electron-name.mjs || true",
    "rebuild": "node ./scripts/rebuild-native.mjs",
    "rebuild:sqlite": "electron-rebuild -f -w better-sqlite3",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64 --x64",
    "dist:mac:arm64": "electron-vite build && electron-builder --mac --arm64",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "db:generate": "ELECTRON_RUN_AS_NODE=1 pnpm exec electron ./node_modules/drizzle-kit/bin.cjs generate",
    "db:push": "ELECTRON_RUN_AS_NODE=1 pnpm exec electron ./node_modules/drizzle-kit/bin.cjs push",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:live": "POND_LIVE=1 vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "^2.0.2",
    "@huggingface/transformers": "^4.2.0",
    "@pond/icons": "workspace:*",
    "@pond/native-glass": "workspace:*",
    "@pond/schema": "workspace:*",
    "@pond/ui": "workspace:*",
    "@tanstack/pacer": "^0.21.1",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.8",
    "@tanstack/react-store": "^0.11.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@tanstack/store": "^0.11.0",
    "better-sqlite3": "^12.11.1",
    "csv-stringify": "^6.7.0",
    "drizzle-orm": "^0.45.2",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "embla-carousel-react": "9.0.0-rc02",
    "ffmpeg-static": "^5.2.0",
    "hono": "^4.12.18",
    "mime-types": "^3.0.2",
    "mitt": "^3.0.1",
    "motion": "^12.39.0",
    "p-limit": "^7.3.0",
    "pretty-bytes": "^7.1.0",
    "pretty-ms": "^9.3.0",
    "rooks": "^9.8.0",
    "rrule": "^2.8.1",
    "sharp": "^0.34.5",
    "ulid": "^3.0.2",
    "which": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tanstack/router-plugin": "^1.168.11",
    "@types/better-sqlite3": "^7.6.12",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@types/which": "^3.0.4",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^42.4.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.8"
  }
}
