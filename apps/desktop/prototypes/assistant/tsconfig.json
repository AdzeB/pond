{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@pond/ui/*": ["../../../../packages/ui/src/*"],
      "@pond/icons/*": ["../../../../packages/icons/*"]
    }
  },
  "include": ["*.ts", "*.tsx"]
}
