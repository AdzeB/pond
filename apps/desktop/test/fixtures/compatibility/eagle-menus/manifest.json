{
  "source": {
    "application": "Eagle",
    "version": "4.0.0",
    "platform": "macOS",
    "evidence": [
      "i18n/en.js",
      "app/app.bundle.js",
      "app/index.html",
      "app/js/fix-utils.js",
      "app/js/preview-window.js"
    ]
  },
  "excluded": [
    {
      "id": "collect-window",
      "reason": "Pond uses extension and capture-queue workflows."
    },
    {
      "id": "community",
      "reason": "Pond is local-first and does not provide a hosted Community feed."
    },
    {
      "id": "licensing",
      "reason": "Pond does not use Eagle registration or device licensing."
    },
    {
      "id": "plugins",
      "reason": "Plugin-provided Actions and injected context-menu rows are outside first-party parity."
    }
  ],
