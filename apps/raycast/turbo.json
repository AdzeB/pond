{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "cache": false,
      "inputs": [
        "$TURBO_EXTENDS$",
        "assets/**",
        "package.json",
        "src/**",
        "tsconfig.json"
      ],
      "outputs": []
    },
    "typecheck": {
      "inputs": ["$TURBO_EXTENDS$", "package.json", "src/**", "tsconfig.json"]
    }
  }
}
