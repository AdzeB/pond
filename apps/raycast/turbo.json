{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "cache": false,
      "inputs": ["$TURBO_EXTENDS$", "ai.yaml", "assets/**", "help.md", "package.json", "src/**", "tsconfig.json"],
      "outputs": []
    },
    "typecheck": {
      "inputs": ["$TURBO_EXTENDS$", "package.json", "src/**", "tests/**", "tsconfig.json"]
    },
    "test": {
      "inputs": ["$TURBO_EXTENDS$", "package.json", "src/**", "tests/**"]
    }
  }
}
