{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "components/**",
        "entrypoints/**",
        "public/**",
        "sources/**",
        "styles/**",
        "utils/**",
        "wxt.config.ts",
        "tsconfig.json"
      ],
      "outputs": [".output/**"]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "components/**",
        "entrypoints/**",
        "sources/**",
        "utils/**",
        "wxt.config.ts",
        "tsconfig.json"
      ]
    }
  }
}
