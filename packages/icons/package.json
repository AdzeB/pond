{
  "name": "@pond/icons",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Pond's icon barrel: Nucleo UI packages during development (vendored ≤100 glyphs at release) plus custom social/brand marks.",
  "license": "MIT",
  "author": {
    "name": "Raphael Salaja",
    "url": "https://github.com/raphaelsalaja"
  },
  "homepage": "https://github.com/raphaelsalaja/pond#readme",
  "bugs": {
    "url": "https://github.com/raphaelsalaja/pond/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raphaelsalaja/pond.git",
    "directory": "packages/icons"
  },
  "exports": {
    "./fill/12": "./fill/12/index.ts",
    "./fill/18": "./fill/18/index.ts",
    "./outline/12": "./outline/12/index.ts",
    "./outline/18": "./outline/18/index.ts",
    "./providers": "./providers/index.ts",
    "./social-media": "./social-media/index.ts",
    "./types": "./types.ts"
  },
  "scripts": {
    "generate:icons": "node ./scripts/generate-icons.mjs",
    "generate:providers": "node --experimental-strip-types providers/generate.ts",
    "check:allowlist": "node ./scripts/check-allowlist.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "dependencies": {
    "nucleo-ui-fill-12": "^1.5.0",
    "nucleo-ui-fill-18": "^1.5.0",
    "nucleo-ui-outline-12": "^1.5.0",
    "nucleo-ui-outline-18": "^1.5.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
