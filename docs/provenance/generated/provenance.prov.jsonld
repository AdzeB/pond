        "@id": "source:cosmos-desktop-inspector-panel-ui"
      },
      "provenance:relationshipType": "copied",
      "provenance:contribution": "The [inspector inspiration review](pond-inspector-inspiration-2026-09-22.md)\nselected 20 preview-inspected Cosmos elements from the\n[*Desktop inspector panel UI* search](./REFERENCES.md#cosmos-desktop-inspector-panel-ui).\nThe strongest direction combines a persistent narrow inspector, one aligned\nProperties definition list, restrained section dividers, contextual menus for\nsecondary organization actions, and separate Source and Activity groups. Visible\nCosmos uploader labels do not establish original authorship; original-source links\nand reuse terms were unavailable. This is layout inspiration only. No assets or\ncode were copied.",
      "provenance:target": [
        {
          "@id": "target:area%3Ainfluence%2Feagle-parity-baselines"
        }
      ],
      "provenance:confidence": "unknown",
      "prov:generatedAtTime": "2026-09-24"
    },
    {
      "@id": "influence:eagle-4-20260401-influence-eagle-parity-baselines",
      "@type": "prov:Influence",
      "prov:entity": {
        "@id": "source:eagle-4-20260401"
      },
      "prov:influencer": {
        "@id": "source:eagle-4-20260401"
      },
      "provenance:relationshipType": "consulted",
      "provenance:contribution": "The [separate-window audit](eagle-windows-2026-09-22.md) distinguishes native\nwindows from embedded panels using the installed [Eagle (2026)](./REFERENCES.md#eagle-4-20260401)\nrenderer. Standalone Settings follows [Eagle Team (2026)](./REFERENCES.md#eagle-4-build20-preferences-window),\nand detached video support follows [Eagle Team (2025)](./REFERENCES.md#eagle-4-build9-video-windows).\nPond implements these behaviors independently with scoped Electron preloads.\nThe user-supplied inspector references inform the preview-first single and\nmultiple selection layouts and the unified, media-aware Comments section:\ntimestamped rows for video and thumbnail rows for images. They are private\ndesign input, not bibliography entries.",
      "provenance:target": [
        {
          "@id": "target:area%3Ainfluence%2Feagle-parity-baselines"
        }
      ],
      "provenance:confidence": "unknown",
      "prov:generatedAtTime": "2026-09-24"
    },
