      "prov:influencer": {
        "@id": "source:pinterest-transfer-progress-card"
      },
      "provenance:relationshipType": "copied",
      "provenance:contribution": "The implemented Processing overview follows the reviewed prototype: a bordered\nstatus icon tile, a headline and wrapping description, a secondary action, two\nalways-visible task counts, and a separate hidden-window note. The transfer card's\nstacked status and explanation\n([*Transfer in progress*, n.d.](./REFERENCES.md#pinterest-transfer-progress-card))\ninformed the wrapping layout. Creator and reuse terms are unknown; this is visual\ninspiration only, with no copied assets or code. The live enrichment monitor counts\ntasks rather than unique saves and exposes no stable total, so the card shows real\nrunning and retry counts instead of the prototype's simulated percentages, manual\npause control, or completion totals.",
      "provenance:target": [
        {
          "@id": "target:area%3Ainfluence%2Fprocessing-status-research"
        }
      ],
      "provenance:confidence": "unknown",
      "prov:generatedAtTime": "2026-09-24"
    },
    {
      "@id": "influence:cosmos-sync-status-cards-influence-processing-status-research",
