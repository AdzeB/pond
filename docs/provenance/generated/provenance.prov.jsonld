    {
      "@id": "influence:anthropic-get-api-key-inventory-runtime-dependencies",
      "@type": "prov:Influence",
      "prov:entity": {
        "@id": "source:anthropic-get-api-key"
      },
      "prov:influencer": {
        "@id": "source:anthropic-get-api-key"
      },
      "provenance:relationshipType": "bundled",
      "provenance:contribution": "Enrichments run on-device. Agent uses a key you paste for an official AI SDK chat provider, stored in `safeStorage`, or a local host you run such as Ollama or LM Studio. Pond does not host a model gateway. Official key pages for Anthropic ([Anthropic, n.d.-b](./REFERENCES.md#anthropic-get-api-key)), Gemini ([Google, n.d.-b](./REFERENCES.md#google-gemini-api-keys)), and OpenAI ([OpenAI, n.d.-c](./REFERENCES.md#openai-api-keys)) document those provider keys. Cloud model metadata is fetched without credentials from the public Vercel AI Gateway catalog (`GET https://ai-gateway.vercel.sh/v1/models`; [Vercel, n.d.-i](./REFERENCES.md#vercel-gateway-rest-api)). Gateway models-and-providers documentation ([Vercel, 2026](./REFERENCES.md#vercel-gateway-models)) describes that catalog. The catalog supplies names and metadata, while inference continues directly through the configured provider. Pond also speaks MCP over stdio so Cursor and Claude can search this library. Provider logo tiles in `apps/desktop/src/renderer/src/assets/logos/providers` are vendored from `@lobehub/icons-static-avatar` 1.14.0 ([LobeHub, n.d.](./REFERENCES.md#github-com-lobehub-lobe-icons)).",
      "provenance:target": [
        {
          "@id": "target:area%3Ainventory%2Fruntime-dependencies"
        }
      ],
      "provenance:confidence": "unknown",
      "prov:generatedAtTime": "2026-09-24"
    },
