      "prov:entity": {
        "@id": "source:cosmos-sync-status-cards"
      },
      "prov:influencer": {
        "@id": "source:cosmos-sync-status-cards"
      },
      "provenance:relationshipType": "copied",
      "provenance:contribution": "Searching Cosmos directly surfaced compact sync-status cards\n([*Sync status cards*, n.d.](./REFERENCES.md#cosmos-sync-status-cards)) with\ndistinct in-progress, completed, and delayed states. A status icon and title sit\nabove secondary timing text; separate rows align Events Found and Sources Checked\nwith their counts. This is the closest reference for the proposed Pond processing\noverview: one status header with readable activity counts below. Original creator,\npublication date, and reuse terms are unknown; no code or assets were copied.",
      "provenance:target": [
        {
          "@id": "target:area%3Ainfluence%2Fprocessing-status-research"
        }
      ],
      "provenance:confidence": "unknown",
