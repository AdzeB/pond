      },
      "prov:influencer": {
        "@id": "source:eagle-4-20260401"
      },
      "provenance:relationshipType": "adapted",
      "provenance:contribution": "The [September 23 detail-view comparison](eagle-detail-view-comparison-2026-09-23.md)\ninforms Pond's shared, icon-first viewer chrome across image, video, audio,\ndocument, text, font, model, archive, EPUB, live-photo, web, and generic file\ndetail views. Time-based media keeps utility actions above the canvas and\nplayback transport below it. A user-directed live comparison on September 27\nadditionally informed generated-preview zoom/comment/actual/fit actions; PDF\nthumbnail, search, direct-page, zoom, fit, rotate, print, open, and export\nactions; video and audio volume/sizing/transport actions; toggleable GIF frame\ncontrols; and font Symbols and Information modes. Pond keeps each action group\ncontinuous, with its sole viewer separator reserved for multi-slide navigation.\nThe implementation adapts grouping and placement discipline observed in\n[Eagle (2026)](./REFERENCES.md#eagle-4-20260401), while retaining Pond's own\ncomponents, accessible labels, keyboard behavior, and visual language; no Eagle\napplication code or assets ship in Pond.\nEagle is a behavioral reference for separating a persistent detail-view shell\nfrom raster, temporal, and specialist content providers. Pond's implementation,\naccessibility semantics, security boundaries, and source code are original.",
      "provenance:target": [
        {
          "@id": "target:area%3Ainfluence%2Feagle-parity-baselines"
        },
        {
          "@id": "target:area%3Acomponent%2Fviewers"
        }
      ],
      "provenance:confidence": "verified",
      "prov:generatedAtTime": "2026-09-27"
    },
