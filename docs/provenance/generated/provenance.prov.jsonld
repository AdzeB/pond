    {
      "@id": "influence:en-eagle-cool-support-article-capturing-screenshots-influence-eagle-parity-basel",
      "@type": "prov:Influence",
      "prov:entity": {
        "@id": "source:en-eagle-cool-support-article-capturing-screenshots"
      },
      "prov:influencer": {
        "@id": "source:en-eagle-cool-support-article-capturing-screenshots"
      },
      "provenance:relationshipType": "inspired",
      "provenance:contribution": "The [September 22 screenshot research](eagle-screenshots-2026-09-22.md) uses\n[Eagle (n.d.-p)](./REFERENCES.md#en-eagle-cool-support-article-capturing-screenshots)\nand the installed [Eagle (2026)](./REFERENCES.md#eagle-4-20260401) preferences\nto inform direct area, window, and full-screen capture with optional organization\nafterward. Screenshot tagging\n([Eagle, n.d.-bm](./REFERENCES.md#eagle-disable-screenshot-tags)), notifications\n([Eagle, n.d.-bn](./REFERENCES.md#eagle-disable-screenshot-notification)), and\nRetina capture ([Eagle, n.d.-bo](./REFERENCES.md#eagle-retina-screenshots))\ninform the persistent Screenshots settings page. The shortcut reference\n([Eagle, n.d.-bp](./REFERENCES.md#eagle-keyboard-shortcuts)) conflicts with the\ncapture guide and installed bindings; the note preserves that uncertainty.\nBrowser capture ([Eagle, n.d.-bl](./REFERENCES.md#eagle-browser-extension))\nis recorded separately. At the user's request, screenshot-related source files\nwere extracted into the ignored `apps/desktop/.tmp/eagle-screenshots/` directory,\nwith archive and per-file hashes. The readable Mac capture wrapper delegates\narea/window selection to the operating system. This is behavioral inspiration\nfor Pond’s independently implemented native capture and save dialog; no Eagle code or assets were added to the shipped app,\nand redistribution terms remain unestablished.",
      "provenance:target": [
        {
          "@id": "target:area%3Ainfluence%2Feagle-parity-baselines"
        }
      ],
      "provenance:confidence": "unknown",
      "prov:generatedAtTime": "2026-09-24"
    },
