      },
      "prov:influencer": {
        "@id": "source:linear-app"
      },
      "provenance:relationshipType": "adapted",
      "provenance:contribution": "User-supplied screenshots and the locally installed Linear app informed the\nsingle sidebar-customization dialog, its grouped reorderable rows, visibility\ncontrols, count visibility, and contextual entry point. Pond retains its\nown destinations, design tokens, Nucleo icons, preference model, and source code.",
      "provenance:target": [
        {
          "@id": "target:area%3Afeature%2Fsidebar-customization"
        }
      ],
      "provenance:confidence": "verified",
      "prov:generatedAtTime": "2026-09-25"
    },
    {
      "@id": "influence:dndkit-com-adapted-sidebar-customization-reordering",
      "@type": "prov:Influence",
      "prov:entity": {
        "@id": "source:dndkit-com"
      },
      "prov:influencer": {
        "@id": "source:dndkit-com"
      },
      "provenance:relationshipType": "adapted",
      "provenance:contribution": "dnd kit's sortable interaction model informed Pond's handle-only pointer and\nkeyboard reordering in the customization dialog and live library sidebar,\nincluding detached overlays, cancellation, human-readable announcements,\nreduced-motion handling, and vertical-axis constraints. Pond retains its existing\ngroup-constrained ordering helper and preference persistence flow while using\nthe official @dnd-kit/core, @dnd-kit/modifiers, @dnd-kit/sortable, and\n@dnd-kit/utilities packages. The vertical-axis modifier keeps list drags aligned\nwith their rows.",
      "provenance:target": [
        {
          "@id": "target:area%3Afeature%2Fsidebar-customization"
        },
        {
          "@id": "target:area%3Afeature%2Flibrary-sidebar"
        }
      ],
      "provenance:confidence": "verified",
      "prov:generatedAtTime": "2026-09-25"
    },
    {
      "@id": "influence:dndkit-com-adapted-library-ordering-interactions",
      "@type": "prov:Influence",
      "prov:entity": {
        "@id": "source:dndkit-com"
      },
      "prov:influencer": {
        "@id": "source:dndkit-com"
      },
      "provenance:relationshipType": "adapted",
      "provenance:contribution": "Official dnd kit guidance informed Pond's virtualized vertical Save sorter,\nhorizontal data-table column sorter, and folder-tree organization layer. The\nimplementations use detached overlays, dedicated activator handles, axis\nmodifiers, keyboard coordinates, cancellation, announcements, and reduced-\nmotion-aware landing animations. The folder tree deliberately keeps native\nDataTransfer listeners for Save assignment while dnd kit owns only internal\nfolder organization. Pond retains TanStack Virtual ownership of Save row\nmounting, its existing column-order state, and its folder-domain move planner.",
      "provenance:target": [
        {
          "@id": "target:area%3Afeature%2Farrange-folder"
        },
        {
          "@id": "target:area%3Afeature%2Fdata-table-columns"
        },
        {
          "@id": "target:area%3Afeature%2Ffolder-organization"
        }
      ],
      "provenance:confidence": "verified",
      "prov:generatedAtTime": "2026-09-25"
    },
